# ---------------------------------------------------------------------------
# DATABASE — Supabase PostgreSQL
# Supabase Dashboard > Project Settings > Database > Connection string
#
# DATABASE_URL  : the pooled connection (port 6543, pgbouncer) used at runtime.
# DIRECT_URL    : the direct connection (port 5432) used by Prisma Migrate.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN="https://your-frontend.vercel.app"

# ---------------------------------------------------------------------------
# AUTH — generate a secret with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Admin account. Seeded/updated on `npm run db:seed`. Never commit real values.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# ---------------------------------------------------------------------------
# FUTURE — WhatsApp Cloud API. Leave blank to keep click-to-chat mode.
# The app never auto-sends unless all three are present.
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
