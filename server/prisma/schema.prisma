// Engagement Guest Management & RSVP System
// PostgreSQL (Supabase in production, local Postgres in development)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums

enum RsvpStatus {
  PENDING
  CONFIRMED
  NOT_ATTENDING
}

/// The two ceremonies. Each has its own guest list and its own headcount.
enum FunctionKey {
  ENGAGEMENT
  DAREES
}

enum InvitationStatus {
  NOT_SENT
  SENT
}

enum TemplateKey {
  INVITATION
  REMINDER
  CONFIRMATION
}

/// How an RSVP reached us. MANUAL = admin clicked a button after a WhatsApp
/// reply. WHATSAPP_API is reserved for a future WhatsApp Cloud API webhook.
enum ResponseSource {
  MANUAL
  WHATSAPP_API
  IMPORT
}

/// How an invitation left the system. CLICK_TO_CHAT = wa.me link opened by
/// the admin (today). WHATSAPP_API = sent by the Cloud API (future).
enum InvitationChannel {
  CLICK_TO_CHAT
  WHATSAPP_API
}

// ---------------------------------------------------------------- models

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  date        DateTime @db.Date
  venue       String?
  description String?
  hostName    String?  @map("host_name")
  /// Exactly one event is active at a time; the dashboard reads the active one.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  guests    Guest[]
  templates MessageTemplate[]
  functions EventFunction[]

  @@index([isActive])
  @@map("events")
}

/// A ceremony within the event. Engagement and DAREES are separate functions
/// with separate guest lists, so each keeps its own time, venue and headcount.
model EventFunction {
  id      String      @id @default(uuid()) @db.Uuid
  eventId String      @map("event_id") @db.Uuid
  key     FunctionKey

  name      String
  time      String?
  venue     String?
  /// Controls the order shown in the UI.
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitations GuestInvitation[]

  @@unique([eventId, key])
  @@map("event_functions")
}

/// Links one guest to one function: who is invited to what, how many people,
/// and their RSVP for THAT ceremony. A guest invited only to DAREES simply has
/// no engagement row.
model GuestInvitation {
  id         String @id @default(uuid()) @db.Uuid
  guestId    String @map("guest_id") @db.Uuid
  functionId String @map("function_id") @db.Uuid

  invitedCount   Int @default(1) @map("invited_count")
  confirmedCount Int @default(0) @map("confirmed_count")

  rsvpStatus     RsvpStatus @default(PENDING) @map("rsvp_status")
  rsvpReceivedAt DateTime?  @map("rsvp_received_at")
  checkedInAt    DateTime?  @map("checked_in_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guest    Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  function EventFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  responses RsvpResponse[]

  @@unique([guestId, functionId])
  @@index([functionId, rsvpStatus])
  @@index([guestId])
  @@map("guest_invitations")
}

model Guest {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  /// Short human-readable id shown in the UI, e.g. G-0001.
  code    String @unique

  name       String
  phone      String
  familyName String? @map("family_name")

  /// One WhatsApp message covers every function this guest is invited to,
  /// so "invitation sent" lives on the contact, not on each function.
  invitationStatus InvitationStatus @default(NOT_SENT) @map("invitation_status")

  invitationSentAt DateTime? @map("invitation_sent_at")
  lastReminderAt   DateTime? @map("last_reminder_at")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitations    GuestInvitation[]
  rsvpResponses  RsvpResponse[]
  invitationLogs InvitationLog[]

  @@unique([eventId, phone])
  @@index([name])
  @@index([phone])
  @@index([familyName])
  @@index([invitationStatus])
  @@index([eventId, createdAt])
  @@map("guests")
}

/// Append-only history of every RSVP change. A future WhatsApp webhook can
/// insert here with source = WHATSAPP_API and the raw inbound text.
model RsvpResponse {
  id           String @id @default(uuid()) @db.Uuid
  guestId      String @map("guest_id") @db.Uuid
  /// Which ceremony this reply was about.
  invitationId String @map("invitation_id") @db.Uuid

  status         RsvpStatus
  confirmedCount Int?           @map("confirmed_count")
  source         ResponseSource @default(MANUAL)
  /// Verbatim inbound WhatsApp text, when there is one.
  rawMessage     String?        @map("raw_message")
  respondedAt    DateTime       @default(now()) @map("responded_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  guest      Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  invitation GuestInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([guestId, respondedAt])
  @@index([invitationId, respondedAt])
  @@index([source])
  @@map("rsvp_responses")
}

model MessageTemplate {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  key  TemplateKey
  name String
  /// Supports {{guestName}}, {{familyName}}, {{eventName}}, {{eventDate}},
  /// {{engagementTime}}, {{dareesTime}}, {{venue}}, {{hostName}}, {{invitedCount}}.
  body String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
  @@map("message_templates")
}

/// One row per invitation/reminder the admin actually sent.
model InvitationLog {
  id      String @id @default(uuid()) @db.Uuid
  guestId String @map("guest_id") @db.Uuid

  templateKey     TemplateKey       @map("template_key")
  channel         InvitationChannel @default(CLICK_TO_CHAT)
  /// The exact rendered message, so the history survives template edits.
  messageSnapshot String            @map("message_snapshot")
  sentAt          DateTime          @default(now()) @map("sent_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId, sentAt])
  @@index([templateKey])
  @@map("invitation_logs")
}
